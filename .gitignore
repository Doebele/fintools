# macOS
.DS_Store
**/.DS_Store

# Dependencies
node_modules/
**/node_modules/

# Local data (SQLite DB and WAL files)
data/*.db
data/*.db-shm
data/*.db-wal

# Claude Code session state
.claude/

# DB dumps from `make backup` (contain stored API keys)
backups/*
!backups/.gitkeep

# Environment / local overrides / secrets
.env
.env.local
env.txt
# Settings exports from Import/Export → Settings (contain API keys in plain text)
portfolio-pal-settings*.json

# Editor / IDE
.vscode/
.idea/

# Build artifacts
dist/
build/

# Logs
*.log
npm-debug.log*
