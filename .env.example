# Copy to .env (git-ignored) next to docker-compose.yml. docker compose reads it
# automatically. Never commit the real file — it holds the SMTP password.

# ── Mail (password reset, "password changed" notices) ─────────────
# SMTP access of one mailbox, e.g. Strato: smtp.strato.de, port 465 (SSL).
# Leave SMTP_HOST empty = no mail is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Base for links in mails (production: https://fintools.doebele12.de)
APP_BASE_URL=http://localhost:3002

# ── Optional ──────────────────────────────────────────────────────
# AV_API_KEY=
# FRONTEND_PORT=3002
# BACKEND_PORT=3003
