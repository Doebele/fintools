# Copy to .env.deploy (git-ignored) and fill in your server details.
# Used by ./deploy.sh (make deploy).
SSH_HOST=                   # server IP or hostname, e.g. your Strato VPS IP
SSH_USER=root
SSH_PORT=22
REMOTE_DIR=/home/portfolio  # git checkout of this repo on the server
BRANCH=main                 # branch the server tracks
PUBLIC_URL=                 # e.g. https://fintools.example.com — checked after deploy (optional)
